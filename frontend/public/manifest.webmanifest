{
  "id": "/",
  "name": "Notes",
  "short_name": "Notes",
  "description": "Your class notes, record notes and important updates in one place.",
  "start_url": "/notes/recordnotes",
  "scope": "/",
  "display": "standalone",
  "handle_links": "preferred",

  "protocol_handlers": [
    {
      "protocol": "web+notes",
      "url": "/notes/recordnotes?protocol=%s"
    }
  ],

  "launch_handler": {
    "client_mode": "navigate-existing"
  },
  "background_color": "#eef1f5",
  "theme_color": "#172033",
  "icons": [
    {
      "src": "/note.png",
      "sizes": "512x512",
      "type": "image/png"
    }
  ]
}